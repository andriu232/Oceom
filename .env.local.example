# ============================================================
# OCEOM by E-MOTION® — Variables de entorno
# Copia este archivo a .env.local y rellena con tus valores reales.
# ============================================================

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo server-side. NUNCA exponer al cliente. (Service role / secret key)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ── OMI (asistente de IA) ──
# Mismo stack que QuanTrade: un solo @anthropic-ai/sdk sirve para Kimi y Claude.
# Primario: Kimi K2.6 (Moonshot) vía su endpoint compatible con Anthropic.
#   Consíguela en https://platform.moonshot.ai  (puede ser la MISMA de QuanTrade).
# MOONSHOT_API_KEY=sk-xxxxxxxx
# Fallback opcional: Claude directo (si no hay MOONSHOT_API_KEY).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Modelos (opcional, por si quieres fijar/actualizar versión):
# OMI_KIMI_MODEL=kimi-k2.6
# OMI_CLAUDE_MODEL=claude-sonnet-4-5

# Email (Resend) — correos de Agenda e Inscripción.
# Sin RESEND_API_KEY los correos hacen no-op (no rompen el flujo).
# RESEND_API_KEY=re_xxxxxxxx
# Remitente verificado en Resend (mientras no verifiques dominio, usa el sandbox):
# EMAIL_FROM=OCEOM <onboarding@resend.dev>

# URL pública de la app (para los enlaces dentro de los correos).
# En Vercel debe ser https://oceom.vercel.app (o tu dominio propio).
NEXT_PUBLIC_SITE_URL=https://oceom.vercel.app

# Google Calendar — sincroniza cada clase agendada al calendario de la mentora.
# Service Account con la Google Calendar API habilitada. Valeria comparte su
# calendario con GOOGLE_SA_CLIENT_EMAIL (permiso "Hacer cambios en eventos").
# La private key va entre comillas y con los saltos de línea como \n literales.
# GOOGLE_SA_CLIENT_EMAIL=oceom-agenda@tu-proyecto.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID=valeria@gmail.com

# Windows: si el TLS corporativo rompe fetch en dev, descomenta en tu shell:
# NODE_OPTIONS=--use-system-ca

# ── Bold (pasarela de pago) ──
BOLD_API_KEY=          # Llave de identidad (pública, va en el botón)
BOLD_SECRET_KEY=       # Llave secreta (firma de integridad + webhook)
# BOLD_WEBHOOK_SECRET= # opcional: si el webhook usa un secreto distinto
NEXT_PUBLIC_SITE_URL=https://oceom.33vertebras.com
